{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "NotificationSettings": {
    "IsTestMode": true,
    "TestEmail": "your-test-email@example.com"
  },
  "EmailSettings": {
    "SenderEmail": "your-email@gmail.com",
    "Password": "your-gmail-app-password"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=your-server;Database=DB_MYSECRETARY;User Id=your-username;Password=your-password;Trusted_Connection=False;MultipleActiveResultSets=true;Encrypt=True;TrustServerCertificate=True;"
  }
}
